}

double CharterFlight::calculateBaseFare() const {
    return 1000.0;
}

void CharterFlight::displayDetails() const {
    std::cout << *this
              << " | Type: Charter"
              << " | Contract Holder: " << contractHolder
              << " | Base Fare: $" << calculateBaseFare()
